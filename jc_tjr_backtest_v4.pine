//@version=6
strategy("JC TJR Backtest v4", overlay=true, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1, margin_long=5, margin_short=5, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=1, process_orders_on_close=false)

// ---- Inputs ----
tz        = input.string("America/New_York", "Timezone")
rrFallback= input.float(2.0, "Fallback target (R) if no liquidity target")
maxRiskPts= input.float(15.0, "Max stop size (points)")
useLondon = input.bool(true, "Use London high/low as sweep levels")
useAsian  = input.bool(true, "Use Asian high/low as sweep levels")
usePDHL   = input.bool(true, "Use prior-day high/low as sweep levels")

// ---- Session windows (ET) ----
inSess(s) => not na(time(timeframe.period, s, tz))
asian   = inSess("1800-0300")
london  = inSess("0300-0830")
manip   = inSess("0930-0950")
macro   = inSess("0950-1010")
watch   = inSess("0930-1010")
flatT   = inSess("1200-1201")

// ---- Track Asian / London ranges ----
var float aH = na
var float aL = na
var float lH = na
var float lL = na
var float pdH = na
var float pdL = na
var float dH = na
var float dL = na
newDay = ta.change(time("D", "", tz)) != 0
if newDay
    pdH := dH
    pdL := dL
    dH := high
    dL := low
else
    dH := math.max(nz(dH, high), high)
    dL := math.min(nz(dL, low), low)
if asian and not asian[1]
    aH := high
    aL := low
else if asian
    aH := math.max(aH, high)
    aL := math.min(aL, low)
if london and not london[1]
    lH := high
    lL := low
else if london
    lH := math.max(lH, high)
    lL := math.min(lL, low)

// Liquidity levels: sweeping ANY of them counts (nearest = max of lows / min of highs)
f_levels(isHigh) =>
    arr = array.new_float()
    if useAsian
        array.push(arr, isHigh ? aH : aL)
    if useLondon
        array.push(arr, isHigh ? lH : lL)
    if usePDHL
        array.push(arr, isHigh ? pdH : pdL)
    arr
f_nearest(arr, isHigh) =>
    float v = na
    for x in arr
        if not na(x)
            v := na(v) ? x : (isHigh ? math.min(v, x) : math.max(v, x))
    v
// first level beyond `minPrice` (for longs) / below `maxPrice` (for shorts)
f_target(arr, isHigh, edge) =>
    float v = na
    for x in arr
        if not na(x) and (isHigh ? x >= edge : x <= edge)
            v := na(v) ? x : (isHigh ? math.min(v, x) : math.max(v, x))
    v

// ---- Step 1: Potential — liquidity sweep after the open ----
var bool sslSwept = false
var bool bslSwept = false
var float sweepLow = na
var float sweepHigh = na
var bool tradedToday = false
var float swingHi = na
var float swingLo = na
startWatch = watch and not watch[1]
if startWatch
    sslSwept := false
    bslSwept := false
    tradedToday := false
    sweepLow := low
    sweepHigh := high
    swingHi := high
    swingLo := low
lowArr  = f_levels(false)
highArr = f_levels(true)
lowLiq  = f_nearest(lowArr, false)
highLiq = f_nearest(highArr, true)
if watch
    swingHi := math.max(swingHi, high[1])
    swingLo := math.min(swingLo, low[1])
    if not na(lowLiq) and low < lowLiq
        sslSwept := true
        sweepLow := na(sweepLow) ? low : math.min(sweepLow, low)
    if not na(highLiq) and high > highLiq
        bslSwept := true
        sweepHigh := na(sweepHigh) ? high : math.max(sweepHigh, high)

// ---- Step 2: Confirmation — BOS after the sweep, then a fresh FVG ----
bullFVG = low > high[2]
bearFVG = high < low[2]
bullBOS = close > ta.highest(high, 5)[1]
bearBOS = close < ta.lowest(low, 5)[1]
var bool bosUp = false
var bool bosDn = false
var float fvgMidL = na
var float fvgMidS = na
if startWatch
    bosUp := false
    bosDn := false
    fvgMidL := na
    fvgMidS := na
if watch
    if sslSwept and bullBOS
        bosUp := true
    if bslSwept and bearBOS
        bosDn := true
    if bosUp and bullFVG
        fvgMidL := (low + high[2]) / 2
    if bosDn and bearFVG
        fvgMidS := (high + low[2]) / 2

// ---- Diagnostics: how many days reach each step ----
var int dSweep = 0
var int dBos = 0
var int dFvg = 0
var int dRiskOk = 0
var bool cSweep = false
var bool cBos = false
var bool cFvg = false
var bool cRisk = false
if startWatch
    cSweep := false
    cBos := false
    cFvg := false
    cRisk := false
if watch and (sslSwept or bslSwept) and not cSweep
    cSweep := true
    dSweep += 1
if watch and (bosUp or bosDn) and not cBos
    cBos := true
    dBos += 1
if watch and (not na(fvgMidL) or not na(fvgMidS)) and not cFvg
    cFvg := true
    dFvg += 1

// ---- Step 3: Continuation — limit at FVG equilibrium, entries only in the 9:50-10:10 macro ----
canTrade = macro and not tradedToday and strategy.position_size == 0
if canTrade and not na(fvgMidL)
    entry = fvgMidL
    stop  = sweepLow - 0.25
    risk  = entry - stop
    if risk > 0 and risk <= maxRiskPts
        lt = f_target(highArr, true, entry + risk)
        tgt = na(lt) ? entry + risk * rrFallback : lt
        strategy.entry("L", strategy.long, limit=entry)
        strategy.exit("L-x", "L", stop=stop, limit=tgt)
        tradedToday := true
        if not cRisk
            cRisk := true
            dRiskOk += 1
if canTrade and not tradedToday and not na(fvgMidS)
    entry = fvgMidS
    stop  = sweepHigh + 0.25
    risk  = stop - entry
    if risk > 0 and risk <= maxRiskPts
        st = f_target(lowArr, false, entry - risk)
        tgt = na(st) ? entry - risk * rrFallback : st
        strategy.entry("S", strategy.short, limit=entry)
        strategy.exit("S-x", "S", stop=stop, limit=tgt)
        tradedToday := true
        if not cRisk
            cRisk := true
            dRiskOk += 1

var int dDays = 0
if startWatch
    dDays += 1
var table t = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 20), border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "Sessions tested", text_color=color.white)
    table.cell(t, 1, 0, str.tostring(dDays), text_color=color.white)
    table.cell(t, 0, 1, "1 Sweep", text_color=color.white)
    table.cell(t, 1, 1, str.tostring(dSweep), text_color=color.white)
    table.cell(t, 0, 2, "2 BOS", text_color=color.white)
    table.cell(t, 1, 2, str.tostring(dBos), text_color=color.white)
    table.cell(t, 0, 3, "3 FVG", text_color=color.white)
    table.cell(t, 1, 3, str.tostring(dFvg), text_color=color.white)
    table.cell(t, 0, 4, "Orders (risk ok)", text_color=color.white)
    table.cell(t, 1, 4, str.tostring(dRiskOk), text_color=color.white)
    table.cell(t, 0, 5, "Max stop pts", text_color=color.white)
    table.cell(t, 1, 5, str.tostring(maxRiskPts), text_color=color.white)

// Orders are placed only in the 9:50-10:10 macro; unfilled limits rest until 11:00. Step 4 exit: flat by 12:00 ET
restWin = inSess("0950-1100")
if not restWin and strategy.position_size == 0
    strategy.cancel("L")
    strategy.cancel("S")
if flatT
    strategy.close_all("12:00 flat")

// ---- Visuals ----
bgcolor(manip ? color.new(color.red, 88) : na, title="Manipulation 9:30-9:50")
bgcolor(macro ? color.new(color.green, 88) : na, title="Entry macro 9:50-10:10")
plot(aH, "Asian H", color.new(color.purple, 40), style=plot.style_linebr)
plot(aL, "Asian L", color.new(color.purple, 40), style=plot.style_linebr)
plot(lH, "London H", color.new(color.teal, 40), style=plot.style_linebr)
plot(lL, "London L", color.new(color.teal, 40), style=plot.style_linebr)
